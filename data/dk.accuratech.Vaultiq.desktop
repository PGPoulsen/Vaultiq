[Desktop Entry]
Type=Application
Name=Vaultiq
GenericName=File Explorer
Comment=Browse and manage files with tabs and previews
Exec=vaultiq %U
Icon=system-file-manager
Terminal=false
StartupNotify=true
DBusActivatable=false
Categories=GTK;System;FileTools;FileManager;
MimeType=inode/directory;application/zip;application/x-zip-compressed;application/x-7z-compressed;application/vnd.rar;application/x-rar;application/x-rar-compressed;application/x-tar;application/x-compressed-tar;application/x-bzip-compressed-tar;application/x-bzip2-compressed-tar;application/x-xz-compressed-tar;application/x-zstd-compressed-tar;application/x-lzma-compressed-tar;application/x-lz4-compressed-tar;application/x-lzip-compressed-tar;application/x-cpio;application/vnd.ms-cab-compressed;
Keywords=folder;explorer;files;manager;
